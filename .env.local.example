NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. The site's public address, used in auth email links and link
# previews (server-side only, so no NEXT_PUBLIC_ prefix). Leave it empty
# locally (http://localhost:3000 is used). On Vercel set it to your custom
# domain, e.g. https://www.example.com; if it's empty there, Vercel's own
# production domain is used instead.
SITE_URL=

# Only needed to re-download official US data (npm run data:refresh-scorecard).
# Free key from https://api.data.gov/signup/. Never used by the running app.
SCORECARD_API_KEY=

# Only needed to re-download OpenAlex citation figures (npm run
# data:strength:openalex): your contact email, sent only to OpenAlex for its
# "polite pool". Never used by the running app; not needed on Vercel.
OPENALEX_EMAIL=

# Server-only secret for POST /api/revalidate (refresh cached university data
# after an import). Any long random string; set the same value on Vercel.
REVALIDATE_SECRET=

# Only for manual backups (npm run db:backup): the database connection string
# from Supabase → Project Settings → Database → Connection string (URI, with
# your database password). A secret: never commit it, never put it on Vercel.
SUPABASE_DB_URL=
