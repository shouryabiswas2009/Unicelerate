{
  "name": "unicelerate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e:build": "node scripts/e2e/build.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "db:check": "node scripts/check-sql.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup-db.mjs",
    "data:fetch-scorecard": "node --env-file-if-exists=.env.local scripts/scorecard/fetch.mjs",
    "data:normalize-scorecard": "node scripts/scorecard/normalize.mjs",
    "data:build-scorecard-sql": "node scripts/scorecard/build-seed-sql.mjs",
    "data:refresh-scorecard": "npm run data:fetch-scorecard -- --refresh && npm run data:normalize-scorecard && npm run data:build-scorecard-sql && npm run data:featured",
    "data:featured": "node scripts/build-featured-sql.mjs",
    "data:fx": "node scripts/fx/fetch-ecb.mjs",
    "data:validate-international": "node scripts/curated/build-international-sql.mjs --check",
    "data:build-international": "node scripts/curated/build-international-sql.mjs",
    "data:report": "node scripts/data-report.mjs",
    "data:validate-country-info": "node scripts/curated/build-country-info-sql.mjs --check",
    "data:build-country-info": "node scripts/curated/build-country-info-sql.mjs",
    "brand:icons": "node scripts/brand/build-icons.mjs",
    "check:links": "node scripts/check-links.mjs",
    "data:research-impact:download": "node scripts/research-impact/download.mjs",
    "data:research-impact:build": "node scripts/research-impact/build.mjs",
    "data:strength:openalex": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/strength/fetch-openalex.mjs",
    "data:strength:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/strength/build.mjs",
    "data:campus-life:download": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/campus-life/download.mjs",
    "data:campus-life:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/campus-life/build.mjs",
    "data:export-fixture": "node --env-file-if-exists=.env.local scripts/export-shared-fixture.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "marked": "^18.1.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
