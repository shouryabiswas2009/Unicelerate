{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studycompass-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "studycompass-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "studycompass-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local"
      ],
      "port": 3200
    }
  ]
}